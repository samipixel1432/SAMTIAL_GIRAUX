# Turso (base de datos)
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu_token_aqui

# Cloudinary (fotos de productos)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Clave para proteger el panel de administracion (subir/editar/borrar productos)
ADMIN_PASSWORD=cambia_esta_clave
FLASK_SECRET_KEY=cambia_esto_por_algo_aleatorio
